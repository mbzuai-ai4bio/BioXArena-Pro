#!/bin/bash
# PATH shim: the real OpenCode CLI (we used 1.18.5; BX_OPENCODE_BIN) inside the Landlock sandbox (env BX_PUBLIC / BX_OUTPUT set by run_agent.py).
[ -n "${BX_OPENCODE_BIN:-}" ] || { echo "BX_OPENCODE_BIN is not set" >&2; exit 2; }
exec "${BX_PYTHON:-python}" -I "$(dirname "$(readlink -f "$0")")/../sandbox.py" "$BX_OPENCODE_BIN" "$@"
