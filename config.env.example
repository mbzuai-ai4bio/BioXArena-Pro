# Copy to config.env, fill in, then `source config.env` in every shell / job (harness/worker.sh also reads $BX_CONFIG_ENV).
# Never commit or share config.env: it holds your API keys. config.env is listed in .gitignore.
export BX_ROOT=/path/to/BioXArena-Pro
export BX_DATA_PUBLIC=$BX_ROOT/data/BioXArena-Pro-Data-Public      # extracted from mbzuai-ai4bio/BioXArena-Pro-Public
export BX_DATA_PRIVATE=$BX_ROOT/data/BioXArena-Pro-Data-Private    # extracted from mbzuai-ai4bio/BioXArena-Pro-Private (scoring only)
export BX_OUTPUT_ROOT=$BX_ROOT/outputs
export BX_ARCHIVE_ROOT=$BX_ROOT/archive
# API keys: set the ones for the routes you use (harness/bx_config.py). Keys stay in the environment; nothing writes them to disk.
export OPENROUTER_API_KEY=                 # route "openai": any OpenAI-compatible endpoint (default host https://openrouter.ai/api)
export ANTHROPIC_API_KEY=                  # route "anthropic": Claude Code and the Claude backends of Minimal / OpenCode / Biomni
export GEMINI_API_KEY=                     # route "gemini": Gemini CLI and the Gemini backends of Minimal / OpenCode / Biomni / MLEvolve
# Optional endpoint overrides (an OpenAI-compatible proxy, Anthropic-compatible gateway, ...)
# export BX_OPENAI_BASE=https://openrouter.ai/api
# export BX_ANTHROPIC_BASE=https://api.anthropic.com
# export BX_GOOGLE_API_HOST=https://generativelanguage.googleapis.com
# export BX_CODEX_WIRE_API=responses       # Codex CLI wire protocol on the openai route: responses | chat
# Tools (only needed by the scaffolds that use them); versions we used: Codex CLI 0.163.0, Claude Code 2.1.302, Gemini CLI 0.64.0, OpenCode 1.18.5
export BX_NODE_HOME=$HOME/.nvm/versions/node/v22.22.0               # Node >= 20 (Codex, Gemini CLI, OpenCode)
export BX_CODEX_BIN=$BX_NODE_HOME/lib/node_modules/@openai/codex/bin/codex.js
export BX_CLAUDE_BIN=$HOME/.local/share/claude/versions/2.1.302
export BX_GEMINI_CLI_JS=$BX_NODE_HOME/lib/node_modules/@google/gemini-cli/bundle/gemini.js
export BX_OPENCODE_BIN=$BX_NODE_HOME/lib/node_modules/opencode-ai/bin/opencode.exe
export BIOMNI_DATA_ROOT=/path/to/biomni_root                        # contains biomni_data/data_lake (~15 GB), see harness/download_biomni_data.py
# Optional: extra read-only dirs the sandbox must allow (e.g. cluster CUDA / module trees outside /usr and /opt)
export BX_SANDBOX_EXTRA_RO=
export BX_CONFIG_ENV=$BX_ROOT/config.env
